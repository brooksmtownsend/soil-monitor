[Unit]
Description=Wireless soil moisture monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=soilmonitor
Group=soilmonitor
EnvironmentFile=-/etc/soil-monitor/soil-monitor.env
StateDirectory=soil-monitor
StateDirectoryMode=0750
ExecStart=/usr/local/bin/soil-monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
