[Unit]
Description=Wireless soil moisture OLED display
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=soilmonitor
Group=soilmonitor
SupplementaryGroups=gpio spi
EnvironmentFile=/etc/soil-monitor/soil-monitor.env
ExecStart=/usr/local/bin/soil-monitor
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
